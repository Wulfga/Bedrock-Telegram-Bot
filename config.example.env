# Bot-Token von @BotFather (siehe README.md)
BOT_TOKEN=123456789:AAExampleTokenReplaceThis

# Adresse und Port des Bedrock-Servers (lokal, da Bot im selben Container läuft)
SERVER_HOST=127.0.0.1
SERVER_PORT=19132

# ---------------------------------------------------------------------------
# Standardwerte für Einstellungen, die Admins im Chat ändern können (/settings).
# Eine im Chat gespeicherte Einstellung hat Vorrang; "/settings reset <name>" geht
# zurück auf den Wert hier. Alles Weitere (Token, Pfade, Benutzer-IDs) ändert man
# nur in dieser Datei.
# ---------------------------------------------------------------------------

# Fehler, die NACH dem Serverstart im Log auftauchen, einzeln in die Gruppe melden.
# Fehler/Warnungen während des Starts werden nie einzeln gemeldet, nur zusammengefasst (/error).
ERROR_ALERTS_RUNTIME=true

# Zeitzone für Backup- und Neustartzeiten (der Container selbst läuft oft in UTC)
BOT_TIMEZONE=Europe/Berlin

# Zusätzlicher TCP-Check von SERVER_HOST:SERVER_PORT, nur für eine Warnung in /status
# (seit NetherNet läuft der Verbindungsaufbau über TCP). Löst nie einen Alarm aus.
STATUS_TCP_CHECK=true

# Name des systemd-Dienstes, der neugestartet werden soll
SERVICE_NAME=minecraft-bedrock

# Verzeichnis des Bedrock-Servers (wird für Backups gesichert)
SERVER_DIR=/opt/bedrock

# Telegram-Chat-ID der Gruppe, in die Status/Push-Nachrichten gehen sollen
# (negative Zahl bei Gruppen, z.B. -1001234567890)
GROUP_CHAT_ID=-1001234567890

# Kommagetrennte Liste von Telegram-User-IDs, die /restart und /backup nutzen dürfen
ALLOWED_USER_IDS=111111111,222222222

# Kommagetrennte Liste von Telegram-User-IDs, die zusätzlich /update und
# /restore nutzen dürfen (höhere Berechtigungsstufe). Leer lassen, um
# dieselben Personen wie ALLOWED_USER_IDS zu verwenden.
ADMIN_USER_IDS=111111111

# Wie die Server-Logs für Join/Leave/Fehler-Erkennung gelesen werden:
#   journalctl  - Standard, wenn der Bedrock-Server als systemd-Dienst läuft
#   file        - falls die Konsolenausgabe in eine Datei umgeleitet wird
LOG_MODE=journalctl
LOG_FILE_PATH=

# Wie oft (Sekunden) geprüft wird, ob der Server komplett offline/online ist
POLL_INTERVAL=30

# Pfad zur FIFO für In-Game-Ankündigungen (siehe run-with-fifo.sh)
COMMAND_FIFO_PATH=/opt/bedrock/command_input

# Standard-Countdown für /restart in Sekunden (per /restart <n> überschreibbar)
RESTART_COUNTDOWN_SECONDS=60

# Ablage der Backups (nur hier änderbar)
BACKUP_DIR=/opt/bedrock-backups

# Automatisches Backup: einmal täglich zur eingestellten Uhrzeit
BACKUP_ENABLED=true
BACKUP_TIME=03:30
# Aufbewahrung: das neueste Backup je Tag für die letzten N Tage ...
BACKUP_DAILY_KEEP=7
# ... plus je Woche das neueste für die letzten N Wochen davor ...
BACKUP_WEEKLY_KEEP=4
# ... und die letzten N Sicherungen, die vor /update, /reinstall und /restore entstehen
BACKUP_SAFETY_KEEP=3

# Pfad zur SQLite-Datenbank für Spielzeit-Statistiken
# Standard: stats.db im selben Ordner wie bot.py
#STATS_DB_PATH=/opt/telegram-bedrock-bot/stats.db

# Geplanter täglicher Neustart
SCHEDULED_RESTART_ENABLED=false
SCHEDULED_RESTART_TIME=04:00
SCHEDULED_RESTART_COUNTDOWN_SECONDS=60
SCHEDULED_RESTART_SKIP_IF_EMPTY=true

# Update-Einstellungen (/update)
# Verzeichnis, in das automatisch heruntergeladene Versionen zwischengespeichert
# werden. Wird bei Bedarf automatisch angelegt.
UPDATE_DIR=/opt/bedrock-updates
# Diese Pfade werden beim Update NIE überschrieben
# Achtung: behavior_packs/resource_packs NICHT eintragen - die Standard-Packs müssen
# bei jedem Update mit aktualisiert werden. Eigene Packs bleiben auch so erhalten.
UPDATE_PROTECTED_PATHS=worlds,permissions.json,allowlist.json,server.properties
